{
  "name": "kbaublocks-desktop",
  "productName": "KbauBlocks",
  "version": "1.0.0",
  "description": "KbauBlocks editor for Windows, offline.",
  "main": "main.js",
  "author": "KbauBlocks",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepare-app": "node prepare-app.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource/nunito": "5.1.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "lol.kbau.blocks",
    "productName": "KbauBlocks",
    "copyright": "KbauBlocks contributors. Based on TurboWarp (GPL-3.0).",
    "files": [
      "main.js",
      "icon.png",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KbauBlocks",
      "artifactName": "KbauBlocks-Setup.${ext}"
    },
    "portable": {
      "artifactName": "KbauBlocks-Portable.${ext}"
    }
  }
}
